{
  "name": "gregal-jocs-desktop",
  "productName": "Gregal Jocs",
  "version": "1.87.8",
  "description": "Gregal Jocs desktop application (downloads its backend on first start).",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "npm run backend && electron .",
    "test": "node --test *.test.js",
    "verify-release": "node verify-release.js --jocs",
    "backend": "node build-backend.js",
    "dist-win": "node build-backend.js windows && electron-builder --config electron-builder-jocs.js --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "directories": {
      "output": "./dist"
    },
    "appId": "xyz.solanes.gregal",
    "productName": "Gregal",
    "publish": {
      "provider": "github",
      "owner": "alsolanes",
      "repo": "gregal-jocs",
      "releaseType": "draft"
    },
    "files": [
      "main.js",
      "server-manager.js",
      "backend-download.js",
      "browser-bridge.js",
      "preload.js",
      "mascot-window.js",
      "chrome-extension.js",
      "word-addin.js",
      "mascot-preload.js",
      "mascot.html",
      "mascot-view.js",
      "mascot.css",
      "window-state.js",
      "quick-note.js",
      "preferences.js",
      "navigation.js",
      "updater.js",
      "startup.js",
      "loading.html",
      "error.html",
      "build/icon512.png"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "../extension/chrome",
        "to": "chrome-extension",
        "filter": [
          "**/*",
          "!*.test.js",
          "!package.json"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon512.png",
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "Gregal-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Gregal-Portable-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
